# dsh-langfuse-plus 运行配置模板 —— 复制为 .env 并填入自己的值（勿提交真实凭据）
# 用法：cp .env.example .env 后编辑，或直接 export 到 shell 环境。

# Langfuse 实例地址（缺省本机自托管）
DSH_LANGFUSE_BASE_URL=http://localhost:3000

# Langfuse 项目凭据（在 Langfuse 项目 Settings → API Keys 里获取）
DSH_LANGFUSE_PUBLIC_KEY=lf_pk_REPLACE_ME
DSH_LANGFUSE_SECRET_KEY=lf_sk_REPLACE_ME

# trace 环境标签（development / production）
DSH_LANGFUSE_ENVIRONMENT=development

# 完全关闭插件（1 = 禁用）
# DSH_LANGFUSE_DISABLED=

# Prompt 双向桥开关（0 = 关闭）
# DSH_LANGFUSE_PROMPT_ENABLED=1

# Langfuse 上的 prompt 名与版本标签（双向桥用）
# DSH_LANGFUSE_PROMPT_NAME=dsh-system-prompt
# DSH_LANGFUSE_PROMPT_LABEL=production

# （可选）client 半跳转地址的项目 id（缺省 dsh-prod）
# DSH_LANGFUSE_PROJECT_ID=dsh-prod

# （可选）本机/内网自托管时，若 DSH 进程需直连 localhost 可加：
# NO_PROXY=127.0.0.1,localhost
